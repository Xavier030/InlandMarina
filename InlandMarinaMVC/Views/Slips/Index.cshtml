@model IEnumerable<InlandMarinaData.Entities.Slip>

@{
    ViewData["Title"] = "Available Slips";
}

<div class="container mt-5">
    <h2>Available Slips</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info mt-4">
            <h4>No slips available</h4>
            <p>All slips are currently leased. Please check back later.</p>
        </div>
    }
    else
    {
        <div class="row mt-4">
            @foreach (var slip in Model)
            {
                var isLeased = slip.Leases?.Any(l => l.Active) == true;

                <div class="col-md-4 mb-4">
                    <div class="card @(isLeased ? "border-warning" : "border-success")">
                        <div class="card-header @(isLeased ? "bg-warning" : "bg-success") text-white">
                            <h5>Slip #@slip.ID</h5>
                        </div>
                        <div class="card-body">
                            <p><strong>Size:</strong> @slip.Width'' x @slip.Length''</p>
                            <p><strong>Dock:</strong> @slip.Dock?.Name</p>
                            <p><strong>Services:</strong></p>
                            <ul>
                                @if (slip.Dock?.WaterService == true)
                                {
                                    <li>✅ Water Service</li>
                                }
                                @if (slip.Dock?.ElectricalService == true)
                                {
                                    <li>✅ Electrical Service</li>
                                }
                            </ul>
                            <p>
                                <strong>Status:</strong>
                                @if (isLeased)
                                {
                                    <span class="badge bg-warning">Leased</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Available</span>
                                }
                            </p>

                            @if (!isLeased)
                            {
                                <form asp-controller="Customer" asp-action="LeaseSlip" method="post">
                                    <input type="hidden" name="slipId" value="@slip.ID" />
                                    <button type="submit" class="btn btn-primary">Lease This Slip</button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>