@{
    ViewData["Title"] = "About Inland Marina";
}

<div class="container mt-5">
    <h2>@ViewData["Title"]</h2>

    <div class="row mt-4">
        <div class="col-md-8">
            <h4>Our Story</h4>
            <p>
                Founded in 1995, Inland Marina has been serving the boating community for over 25 years.
                What started as a small family business has grown into one of the premier marina facilities
                in the region.
            </p>
            <p>
                We pride ourselves on providing exceptional service, state-of-the-art facilities, and
                a welcoming community for boaters of all experience levels.
            </p>

            <h4 class="mt-4">Our Facilities</h4>
            <ul>
                <li>150+ slips with various sizes to accommodate boats from 16' to 50'</li>
                <li>Three modern docks with electrical and water service</li>
                <li>24/7 security and surveillance</li>
                <li>Fuel station with premium marine fuel</li>
                <li>Boat maintenance and repair services</li>
                <li>Clubhouse with amenities for members</li>
                <li>Convenient parking and storage options</li>
            </ul>

            <h4 class="mt-4">Our Mission</h4>
            <p>
                To provide a safe, clean, and friendly environment for boat owners while promoting
                responsible boating and environmental stewardship.
            </p>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5>Quick Facts</h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li>✅ Established: 1995</li>
                        <li>✅ Slips Available: 150+</li>
                        <li>✅ Docks: 3 Modern Facilities</li>
                        <li>✅ Services: Full Marina Services</li>
                        <li>✅ Staff: 20+ Experienced Professionals</li>
                        <li>✅ Members: 300+ Happy Boaters</li>
                    </ul>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header">
                    <h5>Certifications</h5>
                </div>
                <div class="card-body">
                    <p>
                        <strong>Clean Marina Certified</strong><br>
                        We are proud to be certified as a Clean Marina, demonstrating our commitment
                        to environmental protection and sustainable practices.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>