@model IEnumerable<InlandMarinaData.Lease>

@{
    ViewData["Title"] = "My Leased Slips";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col">
            <h1 class="text-primary fw-bold">
                <i class="bi bi-file-earmark-text me-2"></i>My Leased Slips
            </h1>
            <p class="text-muted">View and manage your currently leased slips.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            <i class="bi bi-info-circle display-4 mb-3"></i>
            <h4 class="alert-heading">No Leased Slips</h4>
            <p>You haven't leased any slips yet.</p>
            <a asp-controller="Slips" asp-action="Index" class="btn btn-primary mt-3">
                <i class="bi bi-search me-1"></i>Browse Available Slips
            </a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 g-4">
            @foreach (var lease in Model)
            {
                var slip = lease.Slip;
                <div class="col">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-header bg-primary bg-gradient text-white">
                            <h5 class="mb-0">
                                <i class="bi bi-signpost me-2"></i>
                                Slip #@slip.ID
                                <span class="badge bg-light text-primary ms-2">Your Lease</span>
                            </h5>
                        </div>
                        <div class="card-body">
                            <!-- Slip Info -->
                            <div class="d-flex justify-content-between mb-3">
                                <div>
                                    <i class="bi bi-rulers me-1"></i>
                                    <span class="fw-semibold">Dimensions:</span>
                                </div>
                                <span>@slip.Width ft × @slip.Length ft</span>
                            </div>

                            <div class="d-flex justify-content-between mb-3">
                                <div>
                                    <i class="bi bi-building me-1"></i>
                                    <span class="fw-semibold">Dock:</span>
                                </div>
                                <span class="text-primary">@slip.Dock?.Name</span>
                            </div>

                            <hr>

                            <!-- Lease Info -->
                            <div class="d-flex justify-content-between mb-3">
                                <div>
                                    <i class="bi bi-person me-1"></i>
                                    <span class="fw-semibold">Your Customer ID:</span>
                                </div>
                                <span class="text-primary">@lease.CustomerID</span>
                            </div>
                        </div>

                            <!-- Amenities -->
                            <div class="mb-3">
                                <h6 class="fw-semibold mb-2">
                                    <i class="bi bi-gear me-1"></i> Amenities
                                </h6>
                                <div class="d-flex flex-wrap gap-2">
                                    <span class="badge bg-info">
                                        <i class="bi bi-droplet me-1"></i>
                                        Water: @(slip.Dock?.WaterService == true ? "Yes" : "No")
                                    </span>
                                    <span class="badge bg-warning text-dark">
                                        <i class="bi bi-lightning me-1"></i>
                                        Electricity: @(slip.Dock?.ElectricalService == true ? "Yes" : "No")
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="card-footer bg-white border-top">
                            <div class="d-grid">
                                <a asp-controller="Slips" asp-action="Index" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-search me-1"></i>Browse More Slips
                                </a>
                            </div>
                        </div>
                    </div>
            }
        </div>
    }
</div>