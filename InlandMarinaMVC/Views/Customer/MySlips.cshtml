@model IEnumerable<InlandMarinaData.Entities.Lease>

@{
    ViewData["Title"] = "My Slips";
}

<div class="container mt-5">
    <h2>My Leased Slips</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info mt-4">
            <h4>No active leases found</h4>
            <p>You don''t have any active slip leases. <a asp-controller="Home" asp-action="Slips">Browse available slips</a> to make a reservation.</p>
        </div>
    }
    else
    {
        <div class="row mt-4">
            @foreach (var lease in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card">
                        <div class="card-header bg-primary text-white">
                            <h5>Slip #@lease.Slip?.ID</h5>
                        </div>
                        <div class="card-body">
                            <p><strong>Size:</strong> @lease.Slip?.Width'' x @lease.Slip?.Length''</p>
                            <p><strong>Dock:</strong> @lease.Slip?.Dock?.Name</p>
                            <p><strong>Services:</strong></p>
                            <ul>
                                @if (lease.Slip?.Dock?.WaterService == true)
                                {
                                    <li>✅ Water Service</li>
                                }
                                @if (lease.Slip?.Dock?.ElectricalService == true)
                                {
                                    <li>✅ Electrical Service</li>
                                }
                            </ul>

                            @if (lease.StartDate.HasValue)
                            {
                                <p><strong>Start Date:</strong> @lease.StartDate.Value.ToString("yyyy-MM-dd")</p>
                            }

                            @if (lease.EndDate.HasValue)
                            {
                                <p><strong>End Date:</strong> @lease.EndDate.Value.ToString("yyyy-MM-dd")</p>
                            }

                            <p>
                                <strong>Status:</strong>
                                <span class="badge @(lease.Active ? "bg-success" : "bg-secondary")">
                                    @(lease.Active ? "Active" : "Inactive")
                                </span>
                            </p>

                            <div class="mt-3">
                                <button class="btn btn-warning btn-sm" onclick="cancelLease(@lease.ID)">Cancel Lease</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        function cancelLease(leaseId) {
            if (confirm(''Are you sure you want to cancel this lease?'')) {
                fetch(`/Customer/CancelLease/${leaseId}`, {
                    method: ''POST'',
                    headers: {
                        ''RequestVerificationToken'': $(''input[name="__RequestVerificationToken"]'').val(),
                        ''Content-Type'': ''application/json''
                    }
                })
                .then(response => {
                    if (response.ok) {
                        location.reload();
                    } else {
                        alert(''Failed to cancel lease. Please try again.'');
                    }
                })
                .catch(error => {
                    console.error(''Error:'', error);
                    alert(''An error occurred. Please try again.'');
                });
            }
        }
    </script>
}